{
  "name": "@fastquiz/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, API client, and constants for FastQuiz",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "echo 'No tests in @fastquiz/shared'"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
