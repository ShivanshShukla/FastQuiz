SERVICE_NAME=auth-service
ENVIRONMENT=development
DEBUG=True
PORT=8001

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastquiz_auth
REDIS_URL=redis://localhost:6379/0

# Learner JWT Authentication & Sessions
JWT_SECRET=dev-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
LEARNER_JWT_AUDIENCE=fastquiz-learner
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Social OAuth (Google OIDC & GitHub OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-session-secret-key-for-oauth-state-signing

# DPDPA Consent
DPDPA_CURRENT_POLICY_VERSION=2026.1

# Admin Identity & Isolation Settings
ADMIN_JWT_SECRET=admin-secret-key-change-in-production-67890
ADMIN_JWT_AUDIENCE=fastquiz-admin
ADMIN_JWT_PREAUTH_AUDIENCE=fastquiz-admin-preauth
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_PREAUTH_TOKEN_EXPIRE_MINUTES=5

# Rate Limiting & Lockout
ADMIN_MAX_FAILED_ATTEMPTS_PER_IP=10
ADMIN_MAX_FAILED_ATTEMPTS_PER_ACCOUNT=5
ADMIN_LOCKOUT_DURATION_SECONDS=900

# Bootstrap Super Admin Credentials
BOOTSTRAP_ADMIN_EMAIL=admin@fastquiz.dev
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Primary Super Admin

# TOTP Encryption Key (AES-256 key, base64 or 32 bytes)
TOTP_ENCRYPTION_KEY=
